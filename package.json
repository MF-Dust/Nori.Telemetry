{
  "name": "@nori/telemetry",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.27.1",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:dry": "wrangler deploy --dry-run --outdir dist",
    "types": "wrangler types",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply nori-telemetry --local",
    "db:migrate:remote": "wrangler d1 migrations apply nori-telemetry --remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260925.1",
    "typescript": "7.0.2",
    "vitest": "5.0.1",
    "wrangler": "4.139.0"
  }
}

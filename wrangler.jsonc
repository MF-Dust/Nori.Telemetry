{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nori-telemetry",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-25",
  "observability": {
    "enabled": true
  },
  "vars": {
    "INGEST_PROJECT": "nori-desktop",
    "ENVIRONMENT": "production",
    "MAX_EVENT_BYTES": "65536",
    "EVENT_RETENTION_DAYS": "30",
    "MAINTENANCE_DELETE_LIMIT": "2000",
    "ARCHIVE_TERMINAL_EVENTS": "1"
  },
  "ratelimits": [
    {
      "name": "INGEST_RATE_LIMITER",
      "namespace_id": "47501",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "triggers": {
    "crons": [
      "17 3 * * *"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nori-telemetry",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "EVENTS",
      "bucket_name": "nori-telemetry-events"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "EVENT_QUEUE",
        "queue": "nori-telemetry-events"
      }
    ],
    "consumers": [
      {
        "queue": "nori-telemetry-events",
        "max_batch_size": 25,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "nori-telemetry-dead-letter"
      }
    ]
  }
}
